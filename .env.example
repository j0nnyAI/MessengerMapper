# Required environment variables for {{PROJECT_NAME}}
# Copy this file to .env and fill in values before running the project.
# Never commit .env — it is in .gitignore.
# All variables are read with os.environ["KEY"] — missing keys raise KeyError at startup.

# --- Example entries (replace with project-specific variables) ---

# Application
# APP_ENV=development
# APP_SECRET_KEY=

# Database (if applicable)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# External APIs (if applicable)
# API_KEY=
# API_BASE_URL=

# AWS (if applicable)
# AWS_REGION=us-east-1
# AWS_PROFILE=

# Nexus engine (optional override — defaults to sibling layout)
# NEXUS_PATH=../THE-NEXUS
